<Window x:Class="LiteHwMon.OsdSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD 设置" Width="470" SizeToContent="Height" MaxHeight="840"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CardBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBrush}"/>
            <Setter Property="BorderBrush" Value="#22252C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock" BasedOn="{StaticResource Lbl}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SliderGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="PosBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12">

            <!-- 显示内容 -->
            <TextBlock Text="显示内容（硬件与指标，勾选后立即生效）" Style="{StaticResource Hdr}"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel x:Name="HardwareHost"/>
            </ScrollViewer>

            <!-- 布局排列 -->
            <TextBlock Text="布局排列" Style="{StaticResource Hdr}"/>
            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="排列方式" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Column="1" x:Name="LayoutCombo" Style="{StaticResource ComboDark}"
                                  SelectionChanged="Layout_SelectionChanged">
                            <ComboBoxItem Content="竖排分行" Tag="Vertical"/>
                            <ComboBoxItem Content="横排单行" Tag="Horizontal"/>
                            <ComboBoxItem Content="横排自动换行" Tag="Wrap"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="行间距" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="RowSpacingSlider" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RowSpacing_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="RowSpacingValue" Text="6" Style="{StaticResource Val}"/>
                    </Grid>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="指标间距" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="CellSpacingSlider" Minimum="2" Maximum="28" SmallChange="1" LargeChange="4"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CellSpacing_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="CellSpacingValue" Text="10" Style="{StaticResource Val}"/>
                    </Grid>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox x:Name="ShowTitleCheck" Content="显示硬件名称" Style="{StaticResource Chk}"
                                  Checked="ShowTitle_Changed" Unchecked="ShowTitle_Changed"/>
                        <CheckBox x:Name="ShowLabelsCheck" Content="显示指标前缀（温/占/频）" Style="{StaticResource Chk}"
                                  Checked="ShowLabels_Changed" Unchecked="ShowLabels_Changed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 字号 -->
            <TextBlock Text="字号（名称与指标独立调节，实时生效）" Style="{StaticResource Hdr}"/>
            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="基础字号" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="FontSlider" Minimum="11" Maximum="20" SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Font_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="FontValue" Text="14" Style="{StaticResource Val}"/>
                    </Grid>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="硬件名称倍率" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="TitleScaleSlider" Minimum="0.6" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="TitleScale_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="TitleScaleValue" Text="×1.00" Style="{StaticResource Val}"/>
                    </Grid>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="指标数值倍率" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="ValueScaleSlider" Minimum="0.6" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="ValueScale_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="ValueScaleValue" Text="×1.00" Style="{StaticResource Val}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <TextBlock Text="外观（文字与数值始终 100% 亮度，仅背景板受以下两项影响）" Style="{StaticResource Hdr}"/>
            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景不透明度" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Opacity_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityValue" Text="78%" Style="{StaticResource Val}"/>
                    </Grid>
                    <Grid Style="{StaticResource SliderGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景深浅（越深对比越强）" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" x:Name="BackingSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Backing_ValueChanged"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock Grid.Column="2" x:Name="BackingValue" Text="40%" Style="{StaticResource Val}"/>
                    </Grid>
                    <TextBlock Text="提示：背景设为 0% 时背景板与描边一起消失，即为纯文字悬浮（仍保留极淡底色以便鼠标拖动）。"
                               Style="{StaticResource Lbl}" TextWrapping="Wrap" Margin="0,6,0,2"/>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox x:Name="ShadowCheck" Content="文字描边（游戏内更清晰）" Style="{StaticResource Chk}"
                                  Checked="Shadow_Changed" Unchecked="Shadow_Changed"/>
                        <CheckBox x:Name="TopmostCheck" Content="窗口置顶（关闭后全屏游戏会盖住它）" Style="{StaticResource Chk}"
                                  Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 位置 -->
            <TextBlock Text="位置（也可直接拖动悬浮窗）" Style="{StaticResource Hdr}"/>
            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource PosBtn}" Content="↖ 左上" Click="Pos_Click" Tag="0,0"/>
                        <Button Style="{StaticResource PosBtn}" Content="▲ 顶中" Click="Pos_Click" Tag="0,1"/>
                        <Button Style="{StaticResource PosBtn}" Content="↗ 右上" Click="Pos_Click" Tag="0,2"/>
                        <Button Style="{StaticResource PosBtn}" Content="◀ 左中" Click="Pos_Click" Tag="1,0"/>
                        <Button Style="{StaticResource PosBtn}" Content="● 居中" Click="Pos_Click" Tag="1,1"/>
                        <Button Style="{StaticResource PosBtn}" Content="▶ 右中" Click="Pos_Click" Tag="1,2"/>
                        <Button Style="{StaticResource PosBtn}" Content="↙ 左下" Click="Pos_Click" Tag="2,0"/>
                        <Button Style="{StaticResource PosBtn}" Content="▼ 底中" Click="Pos_Click" Tag="2,1"/>
                        <Button Style="{StaticResource PosBtn}" Content="↘ 右下" Click="Pos_Click" Tag="2,2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="提示：全屏（独占模式）游戏可能覆盖悬浮窗；无边框/窗口化均可正常显示。"
                       Style="{StaticResource Lbl}" TextWrapping="Wrap" Margin="2,2,0,2"/>
        </StackPanel>
    </ScrollViewer>
</Window>
